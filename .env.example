# Supabase — the anon key is safe in the browser, the service key is NOT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# The one league this deployment serves.
LEAGUE_ID=

# Signs the per-manager password behind PIN sign-in. Any long random string;
# changing it locks every manager out until each PIN is reset, so set it once.
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>`.
CRON_SECRET=
