# Supabase — the anon key is safe in the browser, the service key is NOT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# The one league this deployment serves.
LEAGUE_ID=

# Signs the per-manager password behind PIN sign-in. Any long random string;
# changing it locks every manager out until each PIN is reset, so set it once.
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>`.
CRON_SECRET=

# The every-few-minutes jobs in vercel.json — live scores, email notices and
# the draft clock. Off unless this says "on". Turning them on settles a week
# minutes after its last game rather than at the next morning's run, pushes a
# lead changing hands mid-game to the phones that asked, and emails notices
# where a mail provider is configured. See src/lib/frequent-jobs.ts.
# FREQUENT_JOBS=on

# Web Push. The public half is handed to every browser that subscribes — that
# is its whole job — and the private half signs the requests to the push
# service and must never reach one. Generate a matched pair with:
#   node scripts/vapid-keys.mjs
# Leave them unset and notifications are simply off: nothing is queued, the
# settings panel says so, and the rest of the app is unaffected.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Who a push service should complain to about this application server. A
# mailto: or an https: URL. Optional.
# VAPID_SUBJECT=mailto:commissioner@example.com

# Where ESPN's site API lives. Leave unset in production — it exists so the
# scoreboard parser can be pointed at a recorded response for testing.
# ESPN_API_BASE=
